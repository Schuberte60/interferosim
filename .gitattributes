# .gitattributes -- line endings and binary files
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.png binary
*.pdf binary
# 2026-11-25: test certificates are stored byte for byte (no line-ending
# conversion), so the SHA-256 checksum on a certificate stays verifiable
certificates/** -text
